          "ReconcilePhase2Reboot": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.rebootDispatchResult.Payload.commandId",
                "operationId.$": "$.rebootDispatchResult.Payload.operationId",
                "owner.$": "$.rebootDispatchResult.Payload.owner",
                "fencingToken.$": "$.rebootDispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.rebootReconcileResult",
            "Next": "CheckPhase2RebootComplete"
          },
          "CheckPhase2RebootComplete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.rebootReconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase2Reboot"
              },
              {
                "Variable": "$.rebootReconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase2NodeFailed"
              }
            ],
            "Default": "DispatchPhase2Verify"
          },
          "DispatchPhase2Verify": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
