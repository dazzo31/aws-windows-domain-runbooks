{
  "Comment": "WUU2-CLI Durable Phased Fleet Deployment State Machine. Enforces 5 ordered phases, bounded concurrency, canary gates, BlockOnFailure, and verified reboot/postcheck workflows.",
  "TimeoutSeconds": 14400,
  "StartAt": "ValidateDeploymentPlan",
  "States": {
    "ValidateDeploymentPlan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName.$": "States.Format('wuu-validate-plan-{}', $.environment)",
        "Payload": {
          "planId.$": "$.planId",
          "changeTicket.$": "$.changeTicket",
          "planDigest.$": "$.planDigest",
          "environment.$": "$.environment"
        }
      },
      "ResultPath": "$.validationResult",
      "Next": "ExecutePhase1Canary",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.errorInfo",
          "Next": "DeploymentValidationFailed"
        }
      ]
    },

    "ExecutePhase1Canary": {
      "Type": "Map",
      "Comment": "Phase 1: Canary node execution with MaxConcurrency 1 and strict BlockOnFailure gate.",
      "ItemsPath": "$.targetNodes",
      "MaxConcurrency": 1,
      "Parameters": {
        "node.$": "$$.Map.Item.Value",
        "planId.$": "$.planId",
        "action.$": "$.action",
        "changeTicket.$": "$.changeTicket",
        "workerPackage.$": "$.workerPackage",
        "documentVersion.$": "$.documentVersion",
        "rebootPolicy.$": "$.rebootPolicy",
        "environment.$": "$.environment"
      },
      "Iterator": {
        "StartAt": "FilterPhase1",
        "States": {
          "FilterPhase1": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.node.phase",
                "NumericEquals": 1,
                "Next": "DispatchPhase1Node"
              }
            ],
            "Default": "SkipNonPhase1Node"
          },
          "SkipNonPhase1Node": {
            "Type": "Pass",
            "Result": { "status": "SKIPPED_NOT_PHASE_1" },
            "End": true
          },
          "DispatchPhase1Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "computerName.$": "$.node.computerName",
                "action.$": "$.action",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "workerPackage.$": "$.workerPackage",
                "documentVersion.$": "$.documentVersion",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.dispatchResult",
            "Next": "WaitPhase1Execution"
          },
          "WaitPhase1Execution": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "ReconcilePhase1Node"
          },
          "ReconcilePhase1Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.dispatchResult.Payload.commandId",
                "operationId.$": "$.dispatchResult.Payload.operationId",
                "owner.$": "$.dispatchResult.Payload.owner",
                "fencingToken.$": "$.dispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.reconcileResult",
            "Next": "CheckPhase1Complete"
          },
          "CheckPhase1Complete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase1Execution"
              },
              {
                "Variable": "$.reconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase1NodeFailed"
              },
              {
                "Variable": "$.reconcileResult.Payload.rebootRequired",
                "BooleanEquals": true,
                "Next": "CheckPhase1RebootAllowed"
              }
            ],
            "Default": "Phase1NodeSucceeded"
          },
          "CheckPhase1RebootAllowed": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.rebootPolicy.rebootAllowed",
                "BooleanEquals": true,
                "Next": "DispatchPhase1Reboot"
              }
            ],
            "Default": "Phase1NodeSucceeded"
          },
          "DispatchPhase1Reboot": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "action": "Reboot",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "workerPackage.$": "$.workerPackage",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.rebootDispatchResult",
            "Next": "WaitPhase1Reboot"
          },
          "WaitPhase1Reboot": {
            "Type": "Wait",
            "Seconds": 30,
            "Next": "ReconcilePhase1Reboot"
          },
          "ReconcilePhase1Reboot": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.rebootDispatchResult.Payload.commandId",
                "operationId.$": "$.rebootDispatchResult.Payload.operationId",
                "owner.$": "$.rebootDispatchResult.Payload.owner",
                "fencingToken.$": "$.rebootDispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.rebootReconcileResult",
            "Next": "CheckPhase1RebootComplete"
          },
          "CheckPhase1RebootComplete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.rebootReconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase1Reboot"
              },
              {
                "Variable": "$.rebootReconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase1NodeFailed"
              }
            ],
            "Default": "DispatchPhase1Verify"
          },
          "DispatchPhase1Verify": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "action": "Verify",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "priorBootId.$": "$.rebootReconcileResult.Payload.bootId",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.verifyDispatchResult",
            "Next": "WaitPhase1Verify"
          },
          "WaitPhase1Verify": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "ReconcilePhase1Verify"
          },
          "ReconcilePhase1Verify": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.verifyDispatchResult.Payload.commandId",
                "operationId.$": "$.verifyDispatchResult.Payload.operationId",
                "owner.$": "$.verifyDispatchResult.Payload.owner",
                "fencingToken.$": "$.verifyDispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.verifyReconcileResult",
            "Next": "CheckPhase1VerifyComplete"
          },
          "CheckPhase1VerifyComplete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.verifyReconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase1Verify"
              },
              {
                "Variable": "$.verifyReconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase1NodeFailed"
              }
            ],
            "Default": "Phase1NodeSucceeded"
          },
          "Phase1NodeFailed": {
            "Type": "Fail",
            "Error": "CanaryNodeExecutionFailed",
            "Cause": "Canary node failed during execution or postcheck verification."
          },
          "Phase1NodeSucceeded": {
            "Type": "Pass",
            "Result": { "status": "SUCCEEDED" },
            "End": true
          }
        }
      },
      "ResultPath": "$.phase1Results",
      "Next": "ExecutePhase2Batch1",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.phase1Error",
          "Next": "BlockOnPhaseFailure"
        }
      ]
    },

    "ExecutePhase2Batch1": {
      "Type": "Map",
      "Comment": "Phase 2: Non-critical batch execution with MaxConcurrency 5 and BlockOnFailure gate.",
      "ItemsPath": "$.targetNodes",
