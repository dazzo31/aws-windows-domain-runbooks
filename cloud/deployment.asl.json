      },
      "Iterator": {
        "StartAt": "FilterPhase2",
        "States": {
          "FilterPhase2": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.node.phase",
                "NumericEquals": 2,
                "Next": "DispatchPhase2Node"
              }
            ],
            "Default": "SkipNonPhase2Node"
          },
          "SkipNonPhase2Node": {
            "Type": "Pass",
            "Result": { "status": "SKIPPED_NOT_PHASE_2" },
            "End": true
          },
          "DispatchPhase2Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "computerName.$": "$.node.computerName",
                "action.$": "$.action",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "workerPackage.$": "$.workerPackage",
                "documentVersion.$": "$.documentVersion",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.dispatchResult",
            "Next": "WaitPhase2Execution"
          },
          "WaitPhase2Execution": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "ReconcilePhase2Node"
          },
          "ReconcilePhase2Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
