        "StartAt": "FilterPhase4",
        "States": {
          "FilterPhase4": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.node.phase",
                "NumericEquals": 4,
                "Next": "DispatchPhase4Node"
              }
            ],
            "Default": "SkipNonPhase4Node"
          },
          "SkipNonPhase4Node": {
            "Type": "Pass",
            "Result": { "status": "SKIPPED_NOT_PHASE_4" },
            "End": true
          },
          "DispatchPhase4Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "computerName.$": "$.node.computerName",
                "action.$": "$.action",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "workerPackage.$": "$.workerPackage",
                "documentVersion.$": "$.documentVersion",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.dispatchResult",
            "Next": "WaitPhase4Execution"
          },
          "WaitPhase4Execution": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "ReconcilePhase4Node"
          },
          "ReconcilePhase4Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.dispatchResult.Payload.commandId",
                "operationId.$": "$.dispatchResult.Payload.operationId",
                "owner.$": "$.dispatchResult.Payload.owner",
                "fencingToken.$": "$.dispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.reconcileResult",
            "Next": "CheckPhase4Complete"
          },
          "CheckPhase4Complete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase4Execution"
              },
              {
                "Variable": "$.reconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase4NodeFailed"
              },
              {
                "Variable": "$.reconcileResult.Payload.rebootRequired",
                "BooleanEquals": true,
                "Next": "CheckPhase4RebootAllowed"
              }
            ],
            "Default": "Phase4NodeSucceeded"
          },
          "CheckPhase4RebootAllowed": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.rebootPolicy.rebootAllowed",
                "BooleanEquals": true,
                "Next": "DispatchPhase4Reboot"
              }
            ],
            "Default": "Phase4NodeSucceeded"
          },
          "DispatchPhase4Reboot": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "action": "Reboot",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "workerPackage.$": "$.workerPackage",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.rebootDispatchResult",
            "Next": "WaitPhase4Reboot"
          },
          "WaitPhase4Reboot": {
            "Type": "Wait",
            "Seconds": 30,
            "Next": "ReconcilePhase4Reboot"
          },
          "ReconcilePhase4Reboot": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.rebootDispatchResult.Payload.commandId",
                "operationId.$": "$.rebootDispatchResult.Payload.operationId",
                "owner.$": "$.rebootDispatchResult.Payload.owner",
                "fencingToken.$": "$.rebootDispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.rebootReconcileResult",
            "Next": "CheckPhase4RebootComplete"
          },
          "CheckPhase4RebootComplete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.rebootReconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase4Reboot"
              },
              {
                "Variable": "$.rebootReconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase4NodeFailed"
              }
            ],
            "Default": "DispatchPhase4Verify"
          },
          "DispatchPhase4Verify": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "action": "Verify",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "priorBootId.$": "$.rebootReconcileResult.Payload.bootId",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.verifyDispatchResult",
            "Next": "WaitPhase4Verify"
          },
          "WaitPhase4Verify": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "ReconcilePhase4Verify"
          },
          "ReconcilePhase4Verify": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.verifyDispatchResult.Payload.commandId",
                "operationId.$": "$.verifyDispatchResult.Payload.operationId",
                "owner.$": "$.verifyDispatchResult.Payload.owner",
                "fencingToken.$": "$.verifyDispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.verifyReconcileResult",
            "Next": "CheckPhase4VerifyComplete"
          },
          "CheckPhase4VerifyComplete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.verifyReconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase4Verify"
              },
              {
                "Variable": "$.verifyReconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase4NodeFailed"
              }
            ],
            "Default": "Phase4NodeSucceeded"
          },
          "Phase4NodeFailed": {
            "Type": "Fail",
            "Error": "Batch4NodeExecutionFailed",
            "Cause": "Phase 4 node failed during execution or postcheck verification."
          },
          "Phase4NodeSucceeded": {
            "Type": "Pass",
            "Result": { "status": "SUCCEEDED" },
            "End": true
          }
        }
      },
      "ResultPath": "$.phase4Results",
      "Next": "ExecutePhase5Closure",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.phase4Error",
          "Next": "BlockOnPhaseFailure"
        }
      ]
    },

    "ExecutePhase5Closure": {
      "Type": "Map",
      "Comment": "Phase 5: Post-deployment fleet verification and closure with MaxConcurrency 5.",
      "ItemsPath": "$.targetNodes",
      "MaxConcurrency": 5,
      "Parameters": {
        "node.$": "$$.Map.Item.Value",
        "planId.$": "$.planId",
        "action.$": "$.action",
        "changeTicket.$": "$.changeTicket",
        "workerPackage.$": "$.workerPackage",
        "documentVersion.$": "$.documentVersion",
        "rebootPolicy.$": "$.rebootPolicy",
        "environment.$": "$.environment"
      },
      "Iterator": {
        "StartAt": "FilterPhase5",
        "States": {
          "FilterPhase5": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.node.phase",
                "NumericEquals": 5,
                "Next": "DispatchPhase5Node"
              }
            ],
            "Default": "SkipNonPhase5Node"
          },
          "SkipNonPhase5Node": {
            "Type": "Pass",
            "Result": { "status": "SKIPPED_NOT_PHASE_5" },
            "End": true
          },
          "DispatchPhase5Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-dispatch-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "computerName.$": "$.node.computerName",
                "action": "Verify",
                "planId.$": "$.planId",
                "changeTicket.$": "$.changeTicket",
                "workerPackage.$": "$.workerPackage",
                "documentVersion.$": "$.documentVersion",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.dispatchResult",
            "Next": "WaitPhase5Execution"
          },
          "WaitPhase5Execution": {
            "Type": "Wait",
            "Seconds": 15,
            "Next": "ReconcilePhase5Node"
          },
          "ReconcilePhase5Node": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName.$": "States.Format('wuu-reconcile-{}', $.environment)",
              "Payload": {
                "instanceId.$": "$.node.instanceId",
                "commandId.$": "$.dispatchResult.Payload.commandId",
                "operationId.$": "$.dispatchResult.Payload.operationId",
                "owner.$": "$.dispatchResult.Payload.owner",
                "fencingToken.$": "$.dispatchResult.Payload.fencingToken",
                "environment.$": "$.environment"
              }
            },
            "ResultPath": "$.reconcileResult",
            "Next": "CheckPhase5Complete"
          },
          "CheckPhase5Complete": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.reconcileResult.Payload.completed",
                "BooleanEquals": false,
                "Next": "WaitPhase5Execution"
              },
              {
                "Variable": "$.reconcileResult.Payload.status",
                "StringEquals": "FAILED",
                "Next": "Phase5NodeFailed"
              }
            ],
            "Default": "Phase5NodeSucceeded"
          },
          "Phase5NodeFailed": {
            "Type": "Fail",
            "Error": "ClosureNodeExecutionFailed",
            "Cause": "Phase 5 node failed during execution or postcheck verification."
          },
          "Phase5NodeSucceeded": {
            "Type": "Pass",
            "Result": { "status": "SUCCEEDED" },
            "End": true
          }
        }
      },
      "ResultPath": "$.phase5Results",
      "Next": "DeploymentSucceeded",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.phase5Error",
          "Next": "BlockOnPhaseFailure"
        }
      ]
    },

    "BlockOnPhaseFailure": {
      "Type": "Fail",
      "Error": "BlockOnFailureTriggered",
      "Cause": "A target node failed in an earlier phase; BlockOnFailure prevents further phase expansion."
    },

    "DeploymentValidationFailed": {
      "Type": "Fail",
      "Error": "DeploymentValidationFailed",
      "Cause": "Frozen deployment plan or maintenance window validation failed."
    },

    "DeploymentSucceeded": {
      "Type": "Succeed"
    }
  }
}
