            },
            "ResultPath": "$.rebootDispatchResult",
            "Next": "WaitPhase2Reboot"
          },
          "WaitPhase2Reboot": {
            "Type": "Wait",
            "Seconds": 30,
            "Next": "ReconcilePhase2Reboot"
