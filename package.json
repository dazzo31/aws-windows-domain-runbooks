{
  "name": "aws-windows-domain-runbooks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/Validate-Pack.ps1 && node --test tests/fleet-orchestration.test.mjs && node tests/validate-infra.cjs",
    "test:powershell": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/Validate-Pack.ps1",
    "test:orchestration": "node --test tests/fleet-orchestration.test.mjs",
    "test:infra": "node tests/validate-infra.cjs",
    "lint:cfn": "cfn-lint infra/*.yaml",
    "test:documents": "node tests/read-documents.cjs",
    "test:planning": "node tests/validate-planning.cjs",
    "validate": "npm test"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  }
}