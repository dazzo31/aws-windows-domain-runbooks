{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WuuChangePlan",
  "description": "Schema for immutable WUU fleet deployment change plans bound to explicit approvals.",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "timestamp",
    "environment",
    "changeTicket",
    "targetNodes",
    "approvedUpdates",
    "action",
    "workerPackage",
    "documentVersion",
    "maintenanceWindow",
    "rebootPolicy",
    "planDigest"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "planId": {
      "type": "string",
      "pattern": "^plan-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": ["lab", "staging", "prod"]
    },
    "changeTicket": {
      "type": "string",
      "minLength": 1
    },
    "targetNodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["instanceId", "computerName", "nodeClass", "phase"],
        "additionalProperties": false,
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^i-[0-9a-f]{8,17}$"
          },
          "computerName": {
            "type": "string"
          },
          "nodeClass": {
            "type": "string",
            "enum": ["memberServer"]
          },
          "phase": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "approvedUpdates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["updateId", "revisionNumber", "title"],
        "additionalProperties": false,
        "properties": {
          "updateId": {
            "type": "string"
          },
          "revisionNumber": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "action": {
      "type": "string",
      "enum": ["Scan", "Download", "Install"]
    },
    "workerPackage": {
      "type": "object",
      "required": ["s3Uri", "versionId", "sha256"],
      "additionalProperties": false,
      "properties": {
        "s3Uri": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "documentVersion": {
      "type": "string"
    },
    "maintenanceWindow": {
      "type": "object",
      "required": ["startTime", "deadlineTime"],
      "additionalProperties": false,
      "properties": {
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "deadlineTime": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "rebootPolicy": {
      "type": "object",
      "required": ["rebootAllowed", "maxRebootsPerNode"],
      "additionalProperties": false,
      "properties": {
        "rebootAllowed": {
          "type": "boolean"
        },
        "maxRebootsPerNode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  }
}

