{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WuuNodeInventory",
  "description": "Schema for managed Windows EC2 instance identity, capability, and fleet patching eligibility inventory.",
  "type": "object",
  "required": [
    "schemaVersion",
    "timestamp",
    "ec2",
    "node",
    "wsus",
    "eligibility"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ec2": {
      "type": "object",
      "required": [
        "instanceId",
        "region",
        "accountId",
        "instanceType",
        "availabilityZone",
        "privateIpAddress"
      ],
      "additionalProperties": false,
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^i-[0-9a-f]{8,17}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}-[a-z]+-\\d{1}$"
        },
        "accountId": {
          "type": "string",
          "pattern": "^\\d{12}$"
        },
        "instanceType": {
          "type": "string"
        },
        "availabilityZone": {
          "type": "string"
        },
        "privateIpAddress": {
          "type": "string"
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "computerName",
        "domain",
        "domainRole",
        "nodeClass",
        "osName",
        "osVersion",
        "osBuild",
        "psVersion",
        "ssmAgentVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "computerName": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "domainRole": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "nodeClass": {
          "type": "string",
          "enum": ["memberServer", "domainController", "certificateAuthority", "unknown"]
        },
        "osName": {
          "type": "string"
        },
        "osVersion": {
          "type": "string"
        },
        "osBuild": {
          "type": "string"
        },
        "psVersion": {
          "type": "string"
        },
        "ssmAgentVersion": {
          "type": "string"
        }
      }
    },
    "wsus": {
      "type": "object",
      "required": [
        "configuredUrl",
        "useWUServer"
      ],
      "additionalProperties": false,
      "properties": {
        "configuredUrl": {
          "type": "string"
        },
        "statusServerUrl": {
          "type": ["string", "null"]
        },
        "useWUServer": {
          "type": "boolean"
        },
        "targetGroup": {
          "type": ["string", "null"]
        }
      }
    },
    "eligibility": {
      "type": "object",
      "required": [
        "eligibleForFleetPatching",
        "exclusionReason",
        "assignedPhase"
      ],
      "additionalProperties": false,
      "properties": {
        "eligibleForFleetPatching": {
          "type": "boolean"
        },
        "exclusionReason": {
          "type": ["string", "null"]
        },
        "assignedPhase": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  }
}

