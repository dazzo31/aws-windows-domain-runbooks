{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WuuReleaseManifest",
  "description": "Schema for immutable worker package release manifest and provenance tracking.",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseId",
    "timestamp",
    "upstream",
    "package",
    "contents",
    "environment"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "releaseId": {
      "type": "string",
      "pattern": "^rel-[0-9]{8}-[0-9]{6}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "upstream": {
      "type": "object",
      "required": [
        "project",
        "pinnedCommit",
        "pinnedTag",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "enum": ["WUU2-CLI"]
        },
        "pinnedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pinnedTag": {
          "type": "string"
        },
        "license": {
          "type": "string",
          "enum": ["MIT"]
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "fileName",
        "sha256",
        "sizeBytes"
      ],
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "relativePath",
          "sha256",
          "sizeBytes"
        ],
        "additionalProperties": false,
        "properties": {
          "relativePath": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "environment": {
      "type": "string",
      "enum": ["lab", "staging", "prod"]
    }
  }
}

